# Copy to .env and adjust. The app uses PostgreSQL when DATABASE_URL is set.
# Otherwise it keeps the local data/inventory.json file.

DATABASE_URL=postgres://saltbox:saltbox@127.0.0.1:5432/saltbox
SESSION_SECRET=

# Neon Auth + Data API (`neon env pull` writes the NEON_* names).
# Next.js only inlines NEXT_PUBLIC_* into the browser bundle used by lib/neon.ts.
NEON_AUTH_BASE_URL=
NEON_DATA_API_URL=
NEXT_PUBLIC_NEON_AUTH_URL=$NEON_AUTH_BASE_URL
NEXT_PUBLIC_NEON_DATA_API_URL=$NEON_DATA_API_URL
