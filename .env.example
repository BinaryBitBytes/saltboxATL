# Copy to .env and adjust. The app uses PostgreSQL when DATABASE_URL is set.
# Otherwise it keeps the local data/inventory.json file.

DATABASE_URL=postgres://saltbox:saltbox@127.0.0.1:5432/saltbox
SESSION_SECRET=

# Optional. Inbound PDF uploads call Composio image recognition when this is set.
# The default tool is Google Cloud Vision DOCUMENT_TEXT_DETECTION for PDF pages.
# HTTP 401 from Composio means this API key is invalid.
# HTTP 403 means the key is valid but lacks privileges.
# HTTP 400 means a bad request or a missing Vision connection, not a bad key.
# ck_ keys are Connect consumer keys (For You → Settings → Sessions & API Key).
# ak_ keys are project API keys (Settings → Project Settings → API Keys).
# Project ID from Google Cloud console: IAM & Admin → Settings, or the project picker.
# COMPOSIO_API_KEY=
# Leave COMPOSIO_USER_ID empty only when COMPOSIO_CONNECTED_ACCOUNT_ID is also empty.
# With a connected account, copy User ID (Entity ID) from Composio → Connected Accounts.
# COMPOSIO_USER_ID=
# COMPOSIO_VISION_PARENT=projects/your-project/locations/us
# COMPOSIO_VISION_TOOL_SLUG=GOOGLE_CLOUD_VISION_ANNOTATE_FILES
# Google Cloud Vision connection alias. The account id underneath is
# google_cloud_vision_lavabo-weve; either value is accepted.
# A ck_ consumer key uses this alias directly and does not need COMPOSIO_USER_ID.
# An ak_ project key only sees accounts connected inside that project, and then
# COMPOSIO_USER_ID must be the entity id that owns the account.
# COMPOSIO_CONNECTED_ACCOUNT_ID=saltbox_atl_vision
